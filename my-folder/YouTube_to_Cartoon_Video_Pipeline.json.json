      "parameters": {
        "method": "POST",
        "url": "https://YOUR_FFMPEG_SERVICE/compose-video",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"stylized_frames\": \"{{ $json[0].output }}\",\n  \"new_audio_url\": \"{{ $json[1].audio_url }}\",\n  \"output_format\": \"mp4\"\n}",
        "options": {}
      },
      "id": "52f824f7-15fd-47f9-90b5-42bb6693c8d9",
