        "specifyBody": "json",
        "jsonBody": "={\n  \"video_file_url\": \"{{ $json.video_file_url }}\",\n  \"interval_seconds\": 2\n}",
        "options": {}
      },
      "id": "3e8ef7ec-6ecf-4d67-ba4b-60b43d462afe",
      "name": "FFMPEG - Extract Frames",
