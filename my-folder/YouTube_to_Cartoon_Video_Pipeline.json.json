          "conditions": [
            {
              "id": "cond-human-present",
              "leftValue": "={{ JSON.parse($json.message.content).human_present }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
