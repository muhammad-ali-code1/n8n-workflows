    {
      "parameters": {
        "jsCode": "const triggerData = $(\"WhatsApp Trigger\").first().json;\nconst tsMs = Number(triggerData.messages[0].timestamp) * 1000;\nconst withinWindow = (Date.now() - tsMs) < 24 * 60 * 60 * 1000;\nconst agentOutput = $input.first().json.output || '';\nconst hasEscalation = agentOutput.toLowerCase().includes('let me get a member of our clinic staff');\nreturn [{\n  json: {\n    withinWindow,\n    agentOutput,\n    hasEscalation,\n    patientPhone: triggerData.contacts[0].wa_id,\n    patientName: triggerData.contacts[0].profile.name,\n    messageBody: triggerData.messages[0].text.body\n  }\n}];"
      },
