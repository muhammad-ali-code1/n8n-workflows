      "id": "518895c7-52ad-4fcf-9b25-778b2eac81d9",
      "name": "Is Text Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        224,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "const msg = ($input.first().json.messages[0].text.body || '').toLowerCase();\nconst keywords = [\n  'emergency', 'chest pain', \"can't breathe\", 'cannot breathe', 'not breathing',\n  'severe bleeding', 'unconscious', 'stroke', 'heart attack', 'choking',\n  'overdose', 'suicide', 'dying', 'help me', 'dying now'\n];\nconst isEmergency = keywords.some(k => msg.includes(k));\nconst item = $input.first().json;\nreturn [{\n  json: {\n    isEmergency,\n    messageBody: item.messages[0].text.body,\n    patientPhone: item.contacts[0].wa_id,\n    patientName: item.contacts[0].profile.name,\n    messageTimestamp: item.messages[0].timestamp,\n    phoneNumberId: item.metadata.phone_number_id\n  }\n}];"
      },
