    {
      "parameters": {
        "jsCode": "const input=$json;\nconst body=input.body||input;\nlet channel='website';\nlet customerId='';\nlet message='';\nlet imageUrl='';\nlet messageId='';\n\nif(body.entry?.[0]?.changes?.[0]?.value?.messages?.[0]){\n  const m=body.entry[0].changes[0].value.messages[0];\n  channel='whatsapp';\n  customerId=m.from||'';\n  message=m.text?.body||'';\n  messageId=m.id||'';\n  imageUrl=m.image?.url||'';\n}\nelse if(body.entry?.[0]?.messaging?.[0]){\n  const m=body.entry[0].messaging[0];\n  channel='facebook';\n  customerId=m.sender?.id||'';\n  message=m.message?.text||'';\n  messageId=m.message?.mid||'';\n  imageUrl=m.message?.attachments?.find(a=>a.type==='image')?.payload?.url||'';\n}\nelse if(body.instagram?.sender || body.entry?.[0]?.messaging?.[0]){\n  channel='instagram';\n  customerId=body.instagram?.sender?.id||body.entry?.[0]?.messaging?.[0]?.sender?.id||'';\n  message=body.instagram?.message?.text||body.entry?.[0]?.messaging?.[0]?.message?.text||'';\n  messageId=body.instagram?.message?.mid||'';\n  imageUrl=body.instagram?.message?.attachments?.find(a=>a.type==='image')?.payload?.url||'';\n}\nelse{\n  channel=body.channel||'website';\n  customerId=body.customer_id||body.user_id||body.sender_id||'';\n  message=body.message||body.text||body.query||'';\n  messageId=body.message_id||'';\n  imageUrl=body.image_url||'';\n}\n\nreturn [{json:{\n  ...input,\n  channel,\n  customer_id:customerId,\n  message,\n  image_url:imageUrl,\n  message_id:messageId,\n  received_at:new Date().toISOString()\n}}];"
      },
      "id": "6",
      "name": "Normalize Incoming Message",
