      "id": "7",
      "name": "Load Product Catalog",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        -700,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const products=$input.all().map(i=>i.json);\nconst incoming=$('Normalize Incoming Message').first().json;\nconst q=(incoming.message||'').toLowerCase().trim();\nconst terms=q.split(/[^a-z0-9\u0622-\u06cc]+/i).filter(x=>x.length>1);\nfunction score(p){\n  const text=Object.values(p).join(' ').toLowerCase();\n  let s=0;\n  for(const t of terms) if(text.includes(t)) s+=2;\n  if((p['Product Name']||p.product_name||'').toLowerCase().includes(q)) s+=8;\n  return s;\n}\nconst matches=products.map(p=>({...p,_score:score(p)}))\n  .filter(p=>p._score>0).sort((a,b)=>b._score-a._score).slice(0,5);\nreturn [{json:{...incoming,matched_products:matches,product_count:products.length}}];"
      },
      "id": "8",
      "name": "Search Product Catalog",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={{ $('Store Configuration').first().json.gemini_api_key }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({contents:[{parts:[{text:`You are the AI customer support and sales agent for ${$('Store Configuration').first().json.store_name}. Reply naturally and professionally in the customer's language: English, Urdu, Roman Urdu, or mixed language. Use ONLY the supplied product/business data. Never invent price, stock, size, color, delivery charge, return policy, or product details.\n\nClassify the request into one of: greeting, product_search, price, stock, recommendation, order, delivery, return, exchange, complaint, human_handoff, other.\n\nReturn ONLY valid JSON:\n{\n  \"intent\":\"...\",\n  \"language\":\"English|Urdu|Roman Urdu|Mixed\",\n  \"reply\":\"customer-facing reply\",\n  \"matched_product_ids\":[],\n  \"needs_human\":false,\n  \"confidence\":0.0\n}\n\nIf the customer asks for a product and there are several plausible matches, mention up to 3 choices. If data is insufficient, ask a short clarification question. For complaints, complex orders, angry customers, payment problems, or low confidence, set needs_human=true.\n\nCustomer message:\n${JSON.stringify($('Search Product Catalog').first().json.message)}\n\nMatched catalog products:\n${JSON.stringify($('Search Product Catalog').first().json.matched_products)}\n\nStore:\n${$('Store Configuration').first().json.store_name}\nCurrency:\n${$('Store Configuration').first().json.currency}` }]}]}) }}",
        "options": {}
      },
      "id": "9",
      "name": "Gemini Customer Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw=$json.candidates?.[0]?.content?.parts?.[0]?.text||'';\nconst clean=raw.replace(/```json/gi,'').replace(/```/g,'').trim();\nlet ai;\ntry{ai=JSON.parse(clean)}catch{ai={intent:'other',language:'Mixed',reply:'Sorry, I could not process that properly. Let me connect you with our support team.',matched_product_ids:[],needs_human:true,confidence:0}};\nconst base=$('Search Product Catalog').first().json;\nreturn [{json:{...base,...ai,ai_generated_at:new Date().toISOString()}}];"
      },
      "id": "10",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        0
      ]
    },
